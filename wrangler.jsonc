{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chth-cafe-manager",
  "main": "src/server.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // The Worker bundles schema.sql as text and creates its tables on first use.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  // Served on workers.dev, with the admin at /admin and the panel at /panel.
  // For your own domain, add custom domain routes for example.com, admin.example.com and
  // panel.example.com, and remove CAFE_WORKSPACE_PATHS to keep the staff apps on their subdomains.
  "workers_dev": true,
  "vars": {
    "CAFE_WORKSPACE_PATHS": "true"
  },
  // Wrangler creates the database and namespace on the first deploy when no IDs are given.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chth-cafe-db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
