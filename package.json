{
  "name": "chth-cafe-manager",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "db:seed": "wrangler d1 execute chth-cafe-db --local --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute chth-cafe-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute chth-cafe-db --local --file=./backup.sql",
    "db:migrate:remote": "wrangler d1 execute chth-cafe-db --remote --file=./backup.sql",
    "deploy": "npm run build && wrangler deploy",
    "test": "node tests/operations.test.mjs",
    "dev:worker": "wrangler dev --local",
    "dev:ui": "vite"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "lucide-react": "^0.471.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261001.0-alpha",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "undici": "^7.29.1",
    "ws": "^8.21.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
